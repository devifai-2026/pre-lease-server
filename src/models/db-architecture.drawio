        <!-- ============================================================ -->
        <!-- RELATIONSHIP EDGES                                           -->
        <!-- crow's-foot: one (•—) to many (—<)                          -->
        <!-- ============================================================ -->

        <!-- users M:N roles via user_roles -->
        <mxCell id="e-ur-user" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="users" target="user_roles"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-ur-role" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="roles" target="user_roles"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- roles M:N permissions via role_permissions -->
        <mxCell id="e-rp-role" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;exitX=1;exitY=0.8;entryX=0;entryY=0.3;" edge="1" parent="1" source="roles" target="role_permissions"><mxGeometry relative="1" as="geometry" /></mxCell>
